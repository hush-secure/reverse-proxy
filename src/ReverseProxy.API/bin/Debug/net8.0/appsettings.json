{
  "proxySettings": {
    "listenPort": 8080
  },

  "rateLimiting": {
    "enabled": true,
    "requestsPerMinute": 100
  },

  "caching": {
    "enabled": true,
    "Whitelist": [
      "/api/products",
      "/api/categories"
    ],
    "tiers": {
      "lowTraffic": { "durationMinutes": 5 },
      "mediumTraffic": { "requestThreshold": 10, "uniqueIpThreshold": 5, "durationMinutes": 15 },
      "highTraffic": { "requestThreshold": 50, "uniqueIpThreshold": 20, "durationMinutes": 60 }
    }
  },

  "logging": {
    "logToFile": true,
    "filePath": "logs/proxy.log",
    "logLevel": "Information"
  },

  "HealthCheck": {
    "UnhealthyThreshold": 3
  },

  "RateLimiting": {
    "WindowMinutes": 1,
    "DefaultLimit": 60,
    "Routes": {
      "/api/login": 5,
      "/api/upload": 10
    }
  },
  
  "backends": [
    { "id": "server1", "url": "http://localhost:5001", "weight": 1 },
    { "id": "server2", "url": "http://localhost:5002", "weight": 3 },
    { "id": "server3", "url": "http://localhost:5003", "weight": 1 }
  ]
}
